# Variables de entorno -------------------------------
# Copia este archivo a .env.local y rellena los valores.
# En Vercel: Project -> Settings -> Environment Variables

# URL de tu proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anoninima: se expone al navegador, la protege el RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key: SOLO para el servidor. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica del sitio (para redirecciones tras registro/login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ======================================================
# Pagos (planes / freemium). La app funciona sin estos valores:
# la pasarela que no este configurada responde "no configurada".
# ======================================================

# URL publica de la app (se usa para las URLs de retorno de las pasarelas).
# En produccion: https://inventservonline.vercel.app
APP_URL=

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mercado Pago (https://www.mercadopago.com/developers/panel) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- PayPal (https://developer.paypal.com/dashboard/applications) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

